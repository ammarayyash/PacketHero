script = ExtResource("1_qq")
layer_id = "L1"
type = "order"
question = "Ketuk unit data berikut secara berurutan sesuai proses enkapsulasi dari Layer Aplikasi (L7) hingga transmisi fisik (L1):"
options = Array[String]([])
correct_index = 0
